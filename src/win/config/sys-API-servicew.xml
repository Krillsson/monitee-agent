<service>
  <id>sys-api</id>
  <name>sys-API</name>
  <description>System API (sys-API) provide a GraphQL API to your computers hardware.</description>
  <executable>%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe</executable>
  <arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "%BASE%\sysapi-launcher.ps1"</arguments>
  <log mode="roll" />
  <onfailure action="restart" />
</service>
