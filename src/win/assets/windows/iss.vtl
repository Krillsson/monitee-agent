\#define MyAppName "${info.name}"
\#define MyAppVersion "${info.version}"
\#define MyAppPublisher "${info.organizationName}"
\#define MyAppURL "$!{info.organizationUrl}"
\#define MyAppExeName "${info.executable.name}"
\#define MyAppFolder "${info.name}"
\#define MyAppIcon "${info.iconFile.absolutePath}"
\#define ServiceName "sys-api"
\#define ServiceWrapper "sys-API-servicew.exe"

[Setup]
AppId={{{#MyAppName}}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppFolder}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
PrivilegesRequired=admin
CloseApplicationsFilter={#MyAppExeName},{#ServiceWrapper}
#if ($info.licenseFile)
LicenseFile=${info.licenseFile.absolutePath}
#end
SetupIconFile={#MyAppIcon}
UninstallDisplayIcon={app}\{#MyAppExeName}
Compression=lzma
SolidCompression=yes
ArchitecturesInstallIn64BitMode=x64compatible
ArchitecturesAllowed=x64compatible

[Languages]
#foreach ($language in $info.winConfig.setupLanguages.entrySet())
Name: "${language.key}"; MessagesFile: "${language.value}"
#end

[Tasks]
Name: "service"; Description: "Install and start {#MyAppName} as a Windows service"; Check: not ServiceExists

[InstallDelete]
Type: filesandordirs; Name: "{app}\jre"

[Files]
Source: "${info.appFolder}\*"; DestDir: "{app}"; Excludes: "\config\*"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "${info.appFolder}\config\*"; DestDir: "{app}\config"; Flags: onlyifdoesntexist

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\{#MyAppExeName}"

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent runascurrentuser; Check: not ServiceWillRun

[Code]
const
  SC_MANAGER_CONNECT = 1;
  SERVICE_QUERY_STATUS = 4;
  SERVICE_STOP = 32;
  SERVICE_CONTROL_STOP = 1;
  SERVICE_STOPPED = 1;
  SERVICE_STOP_TIMEOUT_MS = 90000;

type
  TServiceStatus = record
    dwServiceType: Cardinal;
    dwCurrentState: Cardinal;
    dwControlsAccepted: Cardinal;
    dwWin32ExitCode: Cardinal;
    dwServiceSpecificExitCode: Cardinal;
    dwCheckPoint: Cardinal;
    dwWaitHint: Cardinal;
  end;

function OpenSCManager(lpMachineName, lpDatabaseName: String; dwDesiredAccess: Cardinal): THandle;
  external 'OpenSCManagerW@advapi32.dll stdcall';
function OpenService(hSCManager: THandle; lpServiceName: String; dwDesiredAccess: Cardinal): THandle;
  external 'OpenServiceW@advapi32.dll stdcall';
function CloseServiceHandle(hSCObject: THandle): Boolean;
  external 'CloseServiceHandle@advapi32.dll stdcall';
function ControlService(hService: THandle; dwControl: Cardinal; var lpServiceStatus: TServiceStatus): Boolean;
  external 'ControlService@advapi32.dll stdcall';
function QueryServiceStatus(hService: THandle; var lpServiceStatus: TServiceStatus): Boolean;
  external 'QueryServiceStatus@advapi32.dll stdcall';

var
  ServiceWasInstalled: Boolean;
  ServiceWasRunning: Boolean;

function OpenAppService(DesiredAccess: Cardinal; var Manager: THandle): THandle;
begin
  Result := 0;
  Manager := OpenSCManager('', 'ServicesActive', SC_MANAGER_CONNECT);
  if Manager <> 0 then
    Result := OpenService(Manager, '{#ServiceName}', DesiredAccess);
end;

procedure CloseAppService(Service, Manager: THandle);
begin
  if Service <> 0 then
    CloseServiceHandle(Service);
  if Manager <> 0 then
    CloseServiceHandle(Manager);
end;

function ServiceExists(): Boolean;
var
  Manager, Service: THandle;
begin
  Service := OpenAppService(SERVICE_QUERY_STATUS, Manager);
  Result := Service <> 0;
  CloseAppService(Service, Manager);
end;

function ServiceIsRunning(): Boolean;
var
  Manager, Service: THandle;
  Status: TServiceStatus;
begin
  Result := False;
  Service := OpenAppService(SERVICE_QUERY_STATUS, Manager);
  if (Service <> 0) and QueryServiceStatus(Service, Status) then
    Result := Status.dwCurrentState <> SERVICE_STOPPED;
  CloseAppService(Service, Manager);
end;

function StopService(): Boolean;
var
  Manager, Service: THandle;
  Status: TServiceStatus;
  Waited: Integer;
  ResultCode: Integer;
begin
  Service := OpenAppService(SERVICE_QUERY_STATUS or SERVICE_STOP, Manager);
  if Service = 0 then
  begin
    Result := True;
    CloseAppService(Service, Manager);
    Exit;
  end;
  Result := False;
  if QueryServiceStatus(Service, Status) then
  begin
    if Status.dwCurrentState <> SERVICE_STOPPED then
    begin
      Log('Stopping service {#ServiceName}');
      Exec(ExpandConstant('{sys}\sc.exe'), 'failure {#ServiceName} reset= 0 actions= ""', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
      ControlService(Service, SERVICE_CONTROL_STOP, Status);
    end;
    Waited := 0;
    while QueryServiceStatus(Service, Status) and (Status.dwCurrentState <> SERVICE_STOPPED) and (Waited < SERVICE_STOP_TIMEOUT_MS) do
    begin
      Sleep(500);
      Waited := Waited + 500;
    end;
    Result := Status.dwCurrentState = SERVICE_STOPPED;
  end;
  CloseAppService(Service, Manager);
end;

function RunServiceWrapper(Command: String): Boolean;
var
  ResultCode: Integer;
begin
  Log('Running {#ServiceWrapper} ' + Command);
  Result := Exec(ExpandConstant('{app}\{#ServiceWrapper}'), Command, ExpandConstant('{app}'), SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0);
  if not Result then
    Log(Format('{#ServiceWrapper} %s failed with exit code %d', [Command, ResultCode]));
end;

function ServiceWillRun(): Boolean;
begin
  Result := ServiceWasRunning or WizardIsTaskSelected('service');
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  Result := '';
  ServiceWasInstalled := ServiceExists();
  ServiceWasRunning := ServiceIsRunning();
  if not StopService() then
    Result := 'The {#ServiceName} service could not be stopped. Stop it from Services and run Setup again.';
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep <> ssPostInstall then
    Exit;
  if WizardIsTaskSelected('service') and not ServiceWasInstalled then
  begin
    if not RunServiceWrapper('install') then
    begin
      SuppressibleMsgBox('The {#ServiceName} service could not be installed. Run install-service.bat in ' + ExpandConstant('{app}') + ' to try again.', mbError, MB_OK, IDOK);
      Exit;
    end;
  end;
  if ServiceWillRun() and not RunServiceWrapper('start') then
    SuppressibleMsgBox('The {#ServiceName} service could not be started. Check the log files in ' + ExpandConstant('{app}') + '.', mbError, MB_OK, IDOK);
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep <> usUninstall then
    Exit;
  if ServiceExists() then
  begin
    StopService();
    RunServiceWrapper('uninstall');
  end;
end;
