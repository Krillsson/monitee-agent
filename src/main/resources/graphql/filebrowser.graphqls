extend type Query {
    fileBrowser: FileBrowser!
}

extend type Subscription {
    # Follow a copy, move, delete or archive operation until it is over.
    # The current state arrives immediately, so subscribing to something that already
    # finished answers with its outcome instead of waiting. The stream completes when the
    # operation reaches COMPLETED, FAILED or CANCELLED. Completes the same way, with nothing
    # emitted, when id is not one this agent is holding on to - never seen, or already past
    # fileBrowser.limits.fileOperationRetentionMinutes
    fileOperationProgress(id: ID!): FileOperation!
}

extend type Mutation {
    # Replace the contents of a text file. Requires READ_WRITE
    saveTextFile(input: SaveTextFileInput!): SaveTextFileOutput!
    # Copy a file, or a directory with everything in it. Requires READ_WRITE
    copyFile(input: CopyFileInput!): FileOperationOutput!
    # Move a file or a directory. Renaming is a move within the same directory. Requires READ_WRITE
    moveFile(input: MoveFileInput!): FileOperationOutput!
    # Delete a file or a directory. Requires READ_WRITE
    deleteFile(input: DeleteFileInput!): FileOperationOutput!
    # Create a directory. Its parent has to exist already. Requires READ_WRITE
    createDirectory(input: CreateDirectoryInput!): CreateDirectoryOutput!
    # Copy several files or directories into one directory, keeping their names. Each one
    # is reported on its own, so a batch where one fails still copies the rest. Requires READ_WRITE
    copyFiles(input: CopyFilesInput!): FileOperationOutput!
    # Move several files or directories into one directory, keeping their names. Requires READ_WRITE
    moveFiles(input: MoveFilesInput!): FileOperationOutput!
    # Delete several files or directories. Requires READ_WRITE
    deleteFiles(input: DeleteFilesInput!): FileOperationOutput!
    # Unpack a zip, tar, tar.gz or gz into a directory that already exists. Requires READ_WRITE
    extractArchive(input: ExtractArchiveInput!): FileOperationOutput!
    # Pack files and directories into a zip. Requires READ_WRITE
    createArchive(input: CreateArchiveInput!): FileOperationOutput!
    # Move a file or directory into the trash of the root it lives in, from where it can be
    # restored. Requires READ_WRITE
    moveToTrash(input: MoveToTrashInput!): MoveToTrashOutput!
    # Put a trashed file back where it came from. Requires READ_WRITE
    restoreFromTrash(input: RestoreFromTrashInput!): RestoreFromTrashOutput!
    # Delete one trashed entry, or the whole trash of every root. Requires READ_WRITE
    emptyTrash(input: EmptyTrashInput!): FileOperationOutput!
    # Ask a running operation to stop. What it has already done stays done. Requires READ_WRITE
    cancelFileOperation(input: CancelFileOperationInput!): FileOperationOutput!
}

# Browsing of the directories listed under fileBrowser.roots in configuration.yml.
# Nothing outside of those directories can be reached, and symbolic links are listed
# but never followed
type FileBrowser {
    # False when the browser is switched off or none of its configured roots could be used.
    # While this is false roots is empty and every other field below answers with an error
    enabled: Boolean!
    # READ exposes browsing, reading and downloading. READ_WRITE also allows the mutations
    # above and uploading
    access: FileBrowserAccess!
    # The ceilings a request can run into, so a client can refuse an oversized upload or
    # edit before streaming a byte instead of after
    limits: FileBrowserLimits!
    # The configured roots, as the paths every other field expects. Start browsing here
    roots: [FileEntry!]!
    listDirectory(path: String!): DirectoryListing!
    # The same listing, one page at a time, for a directory with more entries than
    # listDirectory is willing to return. Same order, so paging through it gives the
    # same sequence
    listDirectoryConnection(path: String!, after: String, first: Int): DirectoryListingConnection!
    # Reads a text file into the response. Refused for anything that is not valid UTF-8
    # or is larger than fileBrowser.maxEditableBytes
    openTextFile(path: String!): TextFileContent!
    # Looks for a name anywhere under path. Bounded by maxResults, maxDepth and a wall clock
    # budget, and truncated says which of them the walk ran into. File contents are not searched
    search(input: FileSearchInput!): FileSearchResult!
    # Adds up a directory recursively. Never part of a listing, because it is a full walk
    directorySize(path: String!, maxDepth: Int = 32): DirectorySize!
    # Look inside a zip without unpacking it. Leave entryPath out for the top of the archive,
    # or pass an entry from a previous listing to go into it. Reading is a read, so this
    # answers in READ mode too. Only zip: tar has no index and a gzipped tar cannot be
    # seeked, so listing either would mean reading the whole archive per screen
    listArchive(path: String!, entryPath: String): ArchiveListing!
    # Whether a delete can go through the trash. False when fileBrowser.trash is off
    trashEnabled: Boolean!
    # Everything in the trash of every root, most recently deleted first
    trash: [TrashEntry!]!
    # Operations that are running, and the ones that finished within
    # fileBrowser.fileOperationRetentionMinutes, most recently started first
    fileOperations: [FileOperation!]!
    # Null once an operation is too old to still be held
    fileOperation(id: ID!): FileOperation
}

enum FileBrowserAccess {
    READ,
    READ_WRITE
}

type FileBrowserLimits {
    # openTextFile and saveTextFile refuse anything larger than this
    maxEditableBytes: Long!
    # The largest upload the server accepts, 0 for no limit
    maxUploadBytes: Long!
    # openLogFileConnection and tailLogFile refuse a file larger than this
    maxLogViewBytes: Long!
    # The wall clock budget search runs into before it reports truncated
    searchTimeoutSeconds: Long!
    # Whether GET /files/thumbnail is served at all. Always false in the native build
    thumbnails: Boolean!
    # A file larger than this has no thumbnail, whatever hasThumbnail on it says
    maxThumbnailSourceBytes: Long!
    # listArchive truncates past this many entries, and extractArchive and createArchive
    # fail an operation that crosses it part way through
    maxArchiveEntries: Int!
    # The same, but for the uncompressed size an archive holds or would unpack to
    maxArchiveBytes: Long!
    # How long a finished FileOperation is still readable through fileOperation and
    # fileOperationProgress
    fileOperationRetentionMinutes: Long!
}

enum FileEntryType {
    FILE,
    DIRECTORY,
    # Listed so it can be shown, but never followed. Reading, downloading or changing one
    # is refused
    SYMLINK,
    OTHER
}

type FileEntry {
    name: String!
    # Absolute path, and the value to pass back into listDirectory, openTextFile,
    # the mutations and the download endpoint
    path: String!
    type: FileEntryType!
    # 0 for anything that is not a regular file. Directories are not sized recursively
    sizeBytes: Long!
    createdAt: Instant
    updatedAt: Instant
    # Null for anything that is not a regular file
    mimeType: String
    # Fetch the icon for this entry at GET /files/icons/{iconId}.svg
    iconId: String!
    # True when this is a text file small enough for openTextFile and saveTextFile
    editable: Boolean!
    # True when this file can be passed to logFiles.openLogFileConnection and the
    # tailLogFile subscription
    openableAsLog: Boolean!
    # True when this file can be passed to extractArchive
    isArchive: Boolean!
    # True when it can also be passed to listArchive, which only zip can answer cheaply
    browsableAsArchive: Boolean!
    # True when GET /files/thumbnail?path=&size= renders this file. Always false in the
    # native build, which has no image decoder
    hasThumbnail: Boolean!
    # By the unix convention of a leading dot, on every platform
    isHidden: Boolean!
    # BasicFileAttributes.lastAccessTime, null on a filesystem that does not keep one
    accessedAt: Instant
    # As "rwxr-xr-x". Null on a filesystem without a POSIX view, Windows among them
    permissions: String
    owner: String
    group: String
    # What a SYMLINK points at, so the UI can explain the dead end. Null for everything else
    linkTarget: String
}

# One thing inside an archive. It is not a file on disk, so it has no path, only where it
# sits inside the archive
type ArchiveEntry {
    name: String!
    # Pass this back as listArchive's entryPath, to extractArchive's entries, or to
    # GET /files/archive/download?path=&entry=
    entryPath: String!
    # DIRECTORY is also reported for a folder the archive only implies by the names in it
    type: FileEntryType!
    # Unpacked size. 0 for a directory, and for an entry whose archive does not record one
    sizeBytes: Long!
    compressedBytes: Long!
    updatedAt: Instant
    mimeType: String
    # Fetch the icon for this entry at GET /files/icons/{iconId}.svg
    iconId: String!
}

type ArchiveListing {
    # The archive that was looked into
    entry: FileEntry!
    # Where inside it this listing is, empty at the top
    entryPath: String!
    # Directories first, then files, both by name
    entries: [ArchiveEntry!]!
    # True when the archive holds more than the browser is willing to read through
    truncated: Boolean!
}

type FileEntryEdge {
    cursor: String!
    node: FileEntry!
}

type DirectoryListingConnection {
    # The directory that was listed
    entry: FileEntry!
    edges: [FileEntryEdge!]!
    pageInfo: PageInfo!
    # How many entries the directory holds in total
    totalCount: Int!
}

input FileSearchInput {
    # The subtree to search. Has to be inside a root like every other path
    path: String!
    # Matched against the name of each entry, case insensitively, anywhere in it
    query: String!
    maxResults: Int = 500
    maxDepth: Int = 16
    includeDirectories: Boolean = true
}

type FileSearchResult {
    entries: [FileEntry!]!
    # True when the walk hit maxResults, maxDepth or the time budget, so there may be more
    truncated: Boolean!
    durationMillis: Long!
}

type DirectorySize {
    entry: FileEntry!
    totalBytes: Long!
    fileCount: Int!
    directoryCount: Int!
    # True when the walk gave up, which makes every figure above a lower bound
    truncated: Boolean!
}

type TrashEntry {
    # Pass this to restoreFromTrash and emptyTrash
    id: String!
    # The trashed file itself, named as it was when it was deleted
    entry: FileEntry!
    # Where it was deleted from, and where restoring puts it back
    originalPath: String!
    deletedAt: Instant
    # The root whose trash it is in
    root: String!
}

type DirectoryListing {
    # The directory that was listed
    entry: FileEntry!
    # Directories first, then files, both by name
    entries: [FileEntry!]!
    # True when the directory holds more entries than the browser is willing to return
    truncated: Boolean!
}

type TextFileContent {
    entry: FileEntry!
    contents: String!
}

input SaveTextFileInput {
    path: String!
    contents: String!
}

input CopyFileInput {
    source: String!
    # Full path of the copy, including its name
    destination: String!
    # Replace the destination when it is already there. A file can only replace a file and a
    # directory only a directory, and copying a directory over one merges the two
    overwrite: Boolean = false
}

input MoveFileInput {
    source: String!
    # Full path to move to, including the name
    destination: String!
    # Replace the destination when it is already there. A file can only replace a file and a
    # directory only a directory, and the directory has to be empty
    overwrite: Boolean = false
}

input CopyFilesInput {
    sources: [String!]!
    # The directory to copy them into. Each keeps its own name
    destinationDirectory: String!
    overwrite: Boolean = false
}

input MoveFilesInput {
    sources: [String!]!
    destinationDirectory: String!
    overwrite: Boolean = false
}

input DeleteFilesInput {
    paths: [String!]!
    recursive: Boolean = false
}

input ExtractArchiveInput {
    # The archive. Its name decides how it is read: zip, tar, tar.gz, tgz or gz
    path: String!
    # An existing directory to unpack into
    destinationDirectory: String!
    # Replace files already in the destination
    overwrite: Boolean = false
    # Unpack only these, as entryPath values from listArchive. A name here takes everything
    # under it with it, so one folder can be asked for. Everything, when left empty
    entries: [String!] = []
}

input CreateArchiveInput {
    sources: [String!]!
    # Full path of the archive to write, ending in .zip
    destination: String!
    overwrite: Boolean = false
}

input MoveToTrashInput {
    path: String!
}

input RestoreFromTrashInput {
    id: String!
    # Replace whatever has taken the original path in the meantime
    overwrite: Boolean = false
}

input EmptyTrashInput {
    # One entry, or the whole trash of every root when left out
    id: String
}

input DeleteFileInput {
    path: String!
    # Deleting a directory that is not empty is refused unless this is true
    recursive: Boolean = false
}

input CreateDirectoryInput {
    path: String!
}

type SaveTextFileOutput {
    success: Boolean!
    # What went wrong, when success is false
    reason: String
    # Which kind of thing went wrong, when success is false
    errorType: FileBrowserErrorType
}

type CreateDirectoryOutput {
    success: Boolean!
    reason: String
    errorType: FileBrowserErrorType
    # The directory that was created, when success is true
    entry: FileEntry
}

# Why something did not work, so a client can tell the cases apart without reading the
# message. reason always carries the human readable version of the same thing
enum FileBrowserErrorType {
    # The request itself was wrong, or the configuration does not allow it
    REFUSED,
    NOT_FOUND,
    ALREADY_EXISTS,
    # A directory still holds something, and recursive was not asked for
    NOT_EMPTY,
    # The user the agent runs as cannot read or write there. In a container that is
    # usually a bind mount owned by someone else, or a missing PUID/PGID
    PERMISSION_DENIED,
    # The volume is full, or a quota on it is
    OUT_OF_SPACE,
    READ_ONLY_FILE_SYSTEM,
    NOT_SUPPORTED,
    CANCELLED,
    # Something else the file system reported
    IO_ERROR
}

type FileOperationFailure {
    path: String!
    reason: String!
    type: FileBrowserErrorType!
}

enum FileOperationType {
    COPY,
    MOVE,
    DELETE,
    EXTRACT_ARCHIVE,
    CREATE_ARCHIVE,
    EMPTY_TRASH
}

enum FileOperationState {
    # Accepted, but waiting for a worker. Only two operations run at once
    QUEUED,
    # Walking a directory source to find real totals before the work starts
    MEASURING,
    RUNNING,
    # Finished. A batch can complete with entries in failures, as long as at least
    # one of its paths worked
    COMPLETED,
    # Gave up, and reason says why. What it had already done stays done. A batch
    # where every path failed ends up here too
    FAILED,
    CANCELLED
}

# Anything that can take a while runs in the background and is followed through here.
# Subscribe with fileOperationProgress, or read it with fileOperation
type FileOperation {
    id: ID!
    type: FileOperationType!
    state: FileOperationState!
    # What it was asked to work on
    paths: [String!]!
    # Where it is putting them, for the types that have somewhere to put them
    destination: String
    startedAt: Instant!
    finishedAt: Instant
    # The file being worked on right now, null once it is over
    currentPath: String
    # Individual files done so far, which for a directory counts what is inside it
    processedFiles: Int!
    # Null when it would have taken a walk to work out, so show a count rather than a bar
    totalFiles: Int
    processedBytes: Long!
    # Null for the same reason as totalFiles, and always null for a delete
    totalBytes: Long
    # A smoothed bytes/second, measured server side. Null once the operation is no longer
    # RUNNING, or before enough has moved to measure a rate
    bytesPerSecond: Long
    # The requested paths that worked, and the ones that did not. A batch attempts all of
    # them, so a failure here does not undo the entries in successes
    successes: [String!]!
    failures: [FileOperationFailure!]!
    # Why it stopped, when state is FAILED
    reason: String
    # Which kind of thing stopped it, when state is FAILED
    errorType: FileBrowserErrorType
}

# The operation was accepted and has started. Follow it with fileOperationProgress.
# success is false when it was refused outright, which is checked before anything is
# touched. A destination the agent cannot write to, and a copy whose bytes will not fit
# on the volume it is going to, are both refused here rather than part way through
type FileOperationOutput {
    success: Boolean!
    reason: String
    errorType: FileBrowserErrorType
    operation: FileOperation
}

input CancelFileOperationInput {
    id: ID!
}

type MoveToTrashOutput {
    success: Boolean!
    reason: String
    errorType: FileBrowserErrorType
    entry: TrashEntry
}

type RestoreFromTrashOutput {
    success: Boolean!
    reason: String
    errorType: FileBrowserErrorType
    # Where it was put back, when success is true
    entry: FileEntry
}


