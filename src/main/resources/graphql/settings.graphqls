extend type Query {
    "The settings the agent is running with. Read-only; sensitive values such as credentials, webhook URLs and configured filesystem paths are never included"
    settings: Settings!
}

type Settings {
    processes: ProcessesSettings!
    formatting: FormattingSettings!
    history: HistorySettings!
    cache: CacheSettings!
    containerUpdateCheck: ContainerUpdateCheckSettings!
    connectivity: ConnectivitySettings!
    discovery: DiscoverySettings!
    "The configured intent. The docker query reports whether Docker is actually reachable, which can differ, for example while the daemon is unreachable"
    docker: DockerSettings!
    "The configured intent. The upsInfo query reports whether the UPS is actually reachable"
    ups: UpsSettings!
    "The configured intent. The systemDaemon query reports whether it is actually reachable"
    systemDaemon: SystemDaemonSettings!
    windowsManagement: WindowsManagementSettings!
    "The configured intent. The fileBrowser query also reports false when none of the configured roots could be used"
    fileBrowser: FileBrowserSettings!
    notifications: NotificationsSettings!
    mqtt: MqttSettings!
}

type ProcessesSettings {
    "False when processes are switched off in configuration.yml, which is why the process list is empty rather than the machine having no processes"
    enabled: Boolean!
}

type FormattingSettings {
    temperatureUnit: TemperatureUnit!
    "temperatureUnit resolved to a concrete unit. Equal to temperatureUnit unless temperatureUnit is SYSTEM, in which case this is what the agent's locale resolved to"
    activeUnit: ActiveTemperatureUnit!
}

enum TemperatureUnit {
    SYSTEM
    CELSIUS
    FAHRENHEIT
}

enum ActiveTemperatureUnit {
    CELSIUS
    FAHRENHEIT
}

type HistorySettings {
    "How often a history point is recorded"
    intervalSeconds: Long!
    "History older than this is deleted"
    retentionDays: Long!
    "Check results are rolled up hourly and daily, each tier kept for its own period"
    checkRawRetentionHours: Long!
    checkHourlyRetentionDays: Long!
    checkDailyRetentionDays: Long!
    "How often the cheap metrics (cpu, memory, network, gpu, disk rates) are sampled"
    metricFastSamplingSeconds: Long!
    "How often the expensive ones (filesystems, S.M.A.R.T, containers, UPS) are sampled"
    metricSlowSamplingSeconds: Long!
    "Metrics are rolled up into five-minute, hourly and daily tiers, each kept for its own period"
    metricRawRetentionHours: Long!
    metricFiveMinuteRetentionHours: Long!
    metricHourlyRetentionDays: Long!
    metricDailyRetentionDays: Long!
}

type CacheSettings {
    enabled: Boolean!
    durationSeconds: Long!
}

type ContainerUpdateCheckSettings {
    enabled: Boolean!
    notify: Boolean!
    notifyStyle: ContainerUpdateNotifyStyle!
    "Hour of the day the digest is sent, when notifyStyle is DAILY_DIGEST"
    digestAtHour: Int!
    intervalMinutes: Long!
    "Name patterns excluded from update checks"
    excludeContainers: [String!]!
}

enum ContainerUpdateNotifyStyle {
    DAILY_DIGEST
    EVERY_CONTAINER
}

type ConnectivitySettings {
    connectivityCheckEnabled: Boolean!
    internetServicesCheckEnabled: Boolean!
}

type DiscoverySettings {
    mdnsEnabled: Boolean!
    upnpEnabled: Boolean!
}

type DockerSettings {
    enabled: Boolean!
}

type UpsSettings {
    enabled: Boolean!
}

type SystemDaemonSettings {
    enabled: Boolean!
}

type WindowsManagementSettings {
    "windows.serviceManagement.enabled. Gates the performWindowsServiceCommand mutation, not the windowsManagement query itself"
    serviceManagementEnabled: Boolean!
}

type FileBrowserSettings {
    enabled: Boolean!
}

type NotificationsSettings {
    ntfyEnabled: Boolean!
    "Number of webhooks configured under notifications.webhooks, regardless of their individual enabled flag"
    webhooksConfigured: Int!
}

type MqttSettings {
    enabled: Boolean!
}
