extend type Query {
    monitors: [Monitor!]!
    monitorById(id: String!): Monitor
    monitorOfTypeByMonitoredItemId(type: MonitorType!, monitoredItemId: String!): Monitor
    events: [Event!]!
    eventById(id: String!): Event
    genericEvents: [GenericEvent!]!
    pastEvents: [PastEvent!]!
    ongoingEvents: [OngoingEvent!]!
    monitorableItemsForType(input: MonitorableItemsInput): MonitorableItemsOutput!
    monitorableEnums: [MonitorableEnum]!
    webServerChecks: [WebserverCheck!]! @deprecated(reason: "Replaced by checks 2026-08-08")
    webServerCheckById(id: UUID!): WebserverCheck @deprecated(reason: "Replaced by checkById 2026-08-08")
    oneOffWebserverCheck(url: String!): OneOffWebserverCheck! @deprecated(reason: "Replaced by the runOneOffHttpCheck mutation 2026-08-08")
    runWebServerCheckNow(webserverCheckId: UUID!): WebserverCheckHistoryEntry @deprecated(reason: "Replaced by the runCheckNow mutation 2026-08-08")
}

extend type Mutation {
    createNumericalValueMonitor(input: CreateNumericalMonitorInput) : CreateMonitorOutput
    createConditionalValueMonitor(input: CreateConditionalMonitorInput) : CreateMonitorOutput
    createFractionalValueMonitor(input: CreateFractionMonitorInput) : CreateMonitorOutput
    createEnumValueMonitor(input: CreateEnumMonitorInput): CreateMonitorOutput
    deleteMonitor(input: DeleteMonitorInput) : DeleteMonitorOutput
    updateNumericalValueMonitor(input: UpdateNumericalValueMonitorInput) : UpdateMonitorOutput
    updateFractionalValueMonitor(input: UpdateFractionalValueMonitorInput) : UpdateMonitorOutput
    updateConditionalValueMonitor(input: UpdateConditionalValueMonitorInput) : UpdateMonitorOutput
    updateEnumValueMonitor(input: UpdateEnumMonitorInput): UpdateMonitorOutput
    deleteEvent(input: DeleteEventInput) : DeleteEventOutput
    deleteEventsForMonitor(input: DeleteEventsForMonitorInput) : DeleteEventOutput
    deletePastEventsForMonitor(input: DeleteEventsForMonitorInput): DeleteEventOutput
    closeOngoingEventForMonitor(input: DeleteEventsForMonitorInput): DeleteEventOutput
    deleteGenericEvent(input: DeleteGenericEventInput): DeleteGenericEventOutput
    addWebServerCheck(input: AddWebServerCheckInput): AddWebServerCheckOutput @deprecated(reason: "Replaced by createHttpCheck 2026-08-08")
    deleteWebServerCheck(input: DeleteWebServerCheckInput): DeleteWebServerCheckOutput @deprecated(reason: "Replaced by deleteCheck 2026-08-08")
}

input CreateNumericalMonitorInput {
    inertiaInSeconds: Int!
    type: MonitorType!
    threshold: Long!
    # Optional earlier threshold. Has to sit on the calm side of threshold, so above it for
    # a monitor that alerts on a value going below. Omit for a monitor with one level
    warningThreshold: Long
    # Drives: serial or name (ignoring case)
    # NIC's: name or MAC address (ignoring case)
    # Process: process ID
    # Docker: full container ID (ignoring case)
    monitoredItemId: String
}

input MonitorableItemsInput {
    type: MonitorType!
}

type MonitorableItemsOutput {
    items: [MonitorableItem!]!
}

input CreateFractionMonitorInput {
    inertiaInSeconds: Int!
    type: MonitorType!
    threshold: Float!
    # Optional earlier threshold. Has to sit on the calm side of threshold, so above it for
    # a monitor that alerts on a value going below. Omit for a monitor with one level
    warningThreshold: Float
    # Drives: serial or name (ignoring case)
    # NIC's: name or MAC address (ignoring case)
    # Process: process ID
    # Docker: full container ID (ignoring case)
    monitoredItemId: String
}

input CreateConditionalMonitorInput {
    inertiaInSeconds: Int!
    type: MonitorType!
    threshold: Boolean!
    # Drives: serial or name (ignoring case)
    # NIC's: name or MAC address (ignoring case)
    # Process: process ID
    # Docker: full container ID (ignoring case)
    monitoredItemId: String
}

input CreateEnumMonitorInput {
    inertiaInSeconds: Int!
    type: MonitorType!
    threshold: String!
    monitoredItemId: String
}

input UpdateNumericalValueMonitorInput {
    monitorId: UUID!
    inertiaInSeconds: Int
    threshold: Long
    warningThreshold: Long
    # Removes the warning threshold. Cannot be combined with warningThreshold
    clearWarningThreshold: Boolean
}

input UpdateFractionalValueMonitorInput {
    monitorId: UUID!
    inertiaInSeconds: Int
    threshold: Float
    warningThreshold: Float
    # Removes the warning threshold. Cannot be combined with warningThreshold
    clearWarningThreshold: Boolean
}

input UpdateConditionalValueMonitorInput {
    monitorId: UUID!
    inertiaInSeconds: Int
    threshold: Boolean
}

input UpdateEnumMonitorInput {
    monitorId: UUID!
    type: MonitorType!
    inertiaInSeconds: Int
    threshold: String
}

type CreateMonitorOutput {
    monitorId: UUID!
}

union UpdateMonitorOutput = UpdateMonitorOutputSucceeded | UpdateMonitorOutputFailed

type UpdateMonitorOutputSucceeded {
    monitorId: UUID!
}

type UpdateMonitorOutputFailed {
    reason: String!
}

input DeleteMonitorInput {
    monitorId: UUID!
}

type DeleteMonitorOutput {
    removed: Boolean!
}

input DeleteEventInput {
    eventId: UUID!
}

input DeleteEventsForMonitorInput {
    monitorId: UUID!
}

type DeleteEventOutput {
    removed: Boolean!
}

type DeleteGenericEventOutput {
    removed: Boolean!
}

input DeleteGenericEventInput{
    eventId: UUID!
}

union AddWebServerCheckOutput = AddWebServerCheckOutputSuccess | AddWebServerCheckOutputFailed

type AddWebServerCheckOutputSuccess {
    id: UUID!
}

type AddWebServerCheckOutputFailed {
    reason: String!
}

input AddWebServerCheckInput {
    url: String!
}

input DeleteWebServerCheckInput {
    id: UUID!
}

type DeleteWebServerCheckOutput{
    removed: Boolean!
}


union MonitoredValue = NumericalValue | FractionalValue | ConditionalValue | EnumValue

type NumericalValue {
    number: Long
}

type FractionalValue {
    fraction: Float
}

type ConditionalValue {
    condition: Boolean
}

type EnumValue {
    type: MonitorType!
    name: String!
    ordinal: Int!
}

type MonitorableEnum{
    type: MonitorType!
    entries: [EnumValue!]!
}

type MonitoredValueHistoryEntry {
    date: String!
    dateTime: OffsetDateTime!
    timestamp: Instant!
    value: MonitoredValue!
}

type Monitor {
    id: UUID!
    inertiaInSeconds: Int!
    type: MonitorType!
    threshold: MonitoredValue!
    # Optional earlier threshold. Crossing it raises a WARNING event that escalates to
    # CRITICAL if threshold is crossed too. Null when the monitor has one level
    warningThreshold: MonitoredValue
    currentValue: MonitoredValue
    # estimated max value of monitored value. Useful while building UI's
    maxValue: MonitoredValue!
    monitoredItemId: String
    monitoredItem: MonitorableItem
    # Served from the tiered metric series. Points beyond the raw window are bucket
    # statistics rather than instantaneous samples: a gauge reports its average, a counter
    # its value at the end of the bucket, and a flag is true only if it held for the whole
    # bucket. Use metricHistory to get the band and the resolution that was served
    history: [MonitoredValueHistoryEntry!]! @deprecated(reason: "Covers only the raw window. Use metricHistory")
    events: [Event!]!
    pastEvents: [PastEvent!]!
    ongoingEvents: [OngoingEvent!]!
    historyBetweenTimestamps(from: Instant!, to: Instant!): [MonitoredValueHistoryEntry!]! @deprecated(reason: "Collapses each bucket to one value. Use metricHistory")
    # Min/avg/max over the range at the coarsest resolution that still covers it.
    # Empty for the process monitors and CONTAINER_UPDATE_AVAILABLE, which are not sampled,
    # and for DISK_SMART_HEALTH, whose health enum has no honest numeric collapse
    metricHistory(from: Instant!, to: Instant!, resolution: HistoryResolution): MetricHistory!
}

enum HistoryResolution {
    # Picks a resolution from the requested range: raw for the last few hours, five-minute
    # buckets up to two days, hourly up to a month, daily beyond that
    AUTO
    RAW
    FIVE_MINUTE
    HOURLY
    DAILY
}

type MetricHistory {
    "The resolution actually served, which may be coarser than the one asked for"
    resolution: HistoryResolution!
    from: Instant!
    to: Instant!
    points: [MetricHistoryPoint!]!
}

type MetricHistoryPoint {
    "Start of the bucket, or the sample timestamp at RAW resolution"
    timestamp: Instant!
    "How many raw samples are behind this point. 1 at RAW"
    samples: Int!
    "Equal to avg and max at RAW, where a point is one sample rather than a band"
    min: Float!
    avg: Float!
    max: Float!
    "The value at the end of the bucket. The only meaningful one for a counter such as bytesReceived"
    last: Float!
}

enum MonitorType {
    CPU_LOAD,
    CPU_TEMP,
    FILE_SYSTEM_SPACE,
    DISK_READ_RATE,
    DISK_WRITE_RATE,
    DISK_TEMPERATURE,
    MEMORY_SPACE @deprecated(reason: "Replaced by MEMORY_USED 2024-03-12"),
    MEMORY_USED,
    NETWORK_UP,
    NETWORK_UPLOAD_RATE,
    NETWORK_DOWNLOAD_RATE,
    CONTAINER_RUNNING,
    CONTAINER_MEMORY_SPACE,
    CONTAINER_CPU_LOAD,
    CONTAINER_UPDATE_AVAILABLE,
    PROCESS_MEMORY_SPACE,
    PROCESS_CPU_LOAD,
    PROCESS_EXISTS,
    CONNECTIVITY,
    EXTERNAL_IP_CHANGED,
    WEBSERVER_UP,
    CHECK_LATENCY,
    LOAD_AVERAGE_ONE_MINUTE,
    LOAD_AVERAGE_FIVE_MINUTES,
    LOAD_AVERAGE_FIFTEEN_MINUTES,
    UPS_OPERATING_NORMALLY,
    UPS_LOAD_PERCENTAGE,
    UPS_LOAD_WATT,
    DISK_SMART_HEALTH,
    GPU_VRAM_USAGE,
    GPU_TEMPERATURE,
    GPU_UTILIZATION
}

type MonitorableItem {
    id: String
    name: String!
    description: String
    maxValue: MonitoredValue!
    currentValue: MonitoredValue!
    type: MonitorType!
}

# How bad the incident is. Agents before 0.46.0 only ever reported CRITICAL
enum EventSeverity {
    WARNING,
    CRITICAL
}

interface Event {
    id: UUID!
    monitor: Monitor!
    startTime: String!
    startTimestamp: Instant!
    severity: EventSeverity!
}

type OngoingEvent implements Event {
    id: UUID!
    monitor: Monitor!
    startTime: String!
    startTimestamp: Instant!
    startValue: MonitoredValue!
    # The level the incident sits at right now. An incident that escalates from WARNING to
    # CRITICAL keeps its id and changes this instead of opening a second event
    severity: EventSeverity!
}

type PastEvent implements Event {
    id: UUID!
    monitor: Monitor!
    startTime: String!
    startTimestamp: Instant!
    endTimestamp: Instant!
    endTime: String!
    endValue: MonitoredValue!
    startValue: MonitoredValue!
    # The highest level the incident reached before it resolved
    severity: EventSeverity!
}

interface GenericEvent {
    id: UUID!
    dateTime: OffsetDateTime! @deprecated(reason: "Replaced by timestamp")
    timestamp: Instant!
    title: String!
    description: String!
}

type UpdateAvailable implements GenericEvent {
    id: UUID!
    dateTime: OffsetDateTime! @deprecated(reason: "Replaced by timestamp")
    timestamp: Instant!
    title: String!
    description: String!
    currentVersion: String!
    newVersion: String!
    changeLogMarkdown: String!
    downloadUrl: String!
    publishDate: String!
}

type ContainerImageUpdateAvailable implements GenericEvent {
    id: UUID!
    dateTime: OffsetDateTime! @deprecated(reason: "Replaced by timestamp")
    timestamp: Instant!
    title: String!
    description: String!
    containerId: String!
    containerName: String!
    imageRef: String!
    remoteDigest: String!
}

type MonitoredItemMissing implements GenericEvent {
    id: UUID!
    dateTime: OffsetDateTime! @deprecated(reason: "Replaced by timestamp")
    timestamp: Instant!
    title: String!
    description: String!
    monitorType: MonitorType!
    monitorId: UUID!
    monitoredItemId: String
}

# An HTTP check seen through the pre-2026-08-08 API. Replaced by HttpCheck
type WebserverCheck {
    id: UUID!
    url: String!
    status: WebserverCheckHistoryEntry
    uptimeMetrics: UptimeMetrics
    historyBetweenTimestamps(from: Instant!, to: Instant!): [WebserverCheckHistoryEntry!]!
}

type UptimeMetrics {
    total: UptimePeriod!
    perDay: [UptimeDay!]!
}

type UptimePeriod {
    periodStart: Instant!
    periodEnd: Instant!
    totalDownTimeSeconds: Long!
    # Carries the percentage of the period spent DOWN, despite the name. Kept as it is
    # because the shipped app compensates for it
    totalUptimePercent: Float! @deprecated(reason: "Holds downtime percent. Replaced by CheckUptime.uptimePercent 2026-08-08")
    totalSeconds: Long!
}

type UptimeDay {
    timestampAtStartOfDay: Instant!
    # Carries the percentage of the day spent DOWN, despite the name. Kept as it is
    # because the shipped app compensates for it
    uptimePercent: Float! @deprecated(reason: "Holds downtime percent. Replaced by CheckHistoryPoint.uptimePercent 2026-08-08")
    downTimeSeconds: Long!
    totalSeconds: Long!
}

# Replaced by CheckResult
type WebserverCheckHistoryEntry {
    id: UUID!
    webserverCheckId: UUID!
    timeStamp: Instant!
    responseCode: Int!
    latencyMs: Long!
    message: String!
    errorBody: String
}

# Replaced by CheckResult
type OneOffWebserverCheck {
    timeStamp: Instant!
    responseCode: Int!
    latencyMs: Long!
    message: String!
    errorBody: String
}