extend type Query {
    docker: Docker!
}

extend type Mutation {
    performDockerContainerCommand(input: PerformDockerContainerCommandInput) : PerformDockerContainerCommandOutput
    # Starts replacing the container with one running the image its reference points at
    # Returns as soon as the update is accepted, the work carries on in the background
    # Follow it with the dockerContainerUpdate subscription, passing the jobId that comes back
    # The container is replaced rather than changed, so it comes back with a different id
    updateDockerContainer(input: UpdateDockerContainerInput) : UpdateDockerContainerOutput

    # Updates a list of containers one at a time, in the order given
    # Returns as soon as the batch is accepted, the work carries on in the background
    # Follow it with the dockerContainerBatchUpdate subscription, passing the batchJobId that
    # comes back. A container failing does not stop the batch, it moves on to the next one
    updateDockerContainers(input: UpdateDockerContainersInput) : UpdateDockerContainersOutput

    # Stops a batch started with updateDockerContainers from starting its next container
    # The container it is in the middle of updating, if any, is not cancelled and is left to
    # finish, successfully or not
    abortDockerContainerBatchUpdate(input: AbortDockerContainerBatchUpdateInput) : AbortDockerContainerBatchUpdateOutput
}

extend type Subscription {
    # Tail a log file at the given path
    # Use the after parameter to pass the cursor from openLogFileConnection
    # Read the log file using openLogFileConnection, up until hasNextPage is false
    # Then pass the endCursor into after here, this ensures no lines are skipped between read + tail
    # If no after is passed, only new lines will be returned
    tailContainerLogs(containerId: String!, after: String, reverse: Boolean): DockerLogMessage!

    # Follow an update started with updateDockerContainer
    #
    # Everything the job has emitted so far is replayed on subscribe, so subscribing after the
    # mutation returned misses nothing, and reconnecting picks up where you left off. The stream
    # completes after DockerContainerUpdateSucceeded or DockerContainerUpdateFailed.
    #
    # The update runs whether or not anyone is listening: unsubscribing does not cancel it, and
    # there is no way to cancel one. Updates run one at a time, so a job may sit doing nothing
    # while an earlier one finishes.
    #
    # A finished job is forgotten after 30 minutes, and jobs do not survive a restart of the
    # agent. Subscribing to a job that is not known yields an empty stream rather than an error,
    # which is indistinguishable from one that finished long ago.
    dockerContainerUpdate(jobId: UUID!): DockerContainerUpdateEvent!

    # Follow a batch started with updateDockerContainers
    #
    # Everything the batch has emitted so far is replayed on subscribe, the same as
    # dockerContainerUpdate, and the same 30 minute forget window and restart behaviour apply.
    # The stream completes after DockerContainerBatchUpdateFinished.
    #
    # This stream only reports which container the batch is on and whether it succeeded. A
    # container's own step-by-step progress, including image pull progress, is on the
    # dockerContainerUpdate subscription using the jobId carried on its
    # DockerContainerBatchUpdateContainerStarted event.
    dockerContainerBatchUpdate(batchJobId: UUID!): DockerContainerBatchUpdateEvent!
}

input PerformDockerContainerCommandInput{
    containerId: String!
    command: ContainerCommand
}

type PerformDockerContainerCommandOutputFailed {
    reason: String!
}

type PerformDockerContainerCommandOutputSucceeded {
    containerId: String!
}

union PerformDockerContainerCommandOutput = PerformDockerContainerCommandOutputSucceeded | PerformDockerContainerCommandOutputFailed

input UpdateDockerContainerInput {
    containerId: String!
    # Pull the image before recreating. False recreates the container on the image already
    # present locally, which is what you want after pulling by hand, and nothing else
    pullImage: Boolean! = true
}

# The update was accepted and is now running
type UpdateDockerContainerOutputStarted {
    # Pass this to the dockerContainerUpdate subscription to follow the update
    jobId: UUID!
    # The container being replaced, not the one that will replace it
    containerId: String!
}

# The update was refused before anything happened: no such container, Docker unavailable, the
# container is managed by Swarm, its image is not a registry reference, or an update of it is
# already running. Failures during the update arrive on the subscription instead
type UpdateDockerContainerOutputFailed {
    reason: String!
}

union UpdateDockerContainerOutput = UpdateDockerContainerOutputStarted | UpdateDockerContainerOutputFailed

enum DockerContainerUpdateStep {
    INSPECTING_CONTAINER,
    PULLING_IMAGE,
    STOPPING_CONTAINER,
    RENAMING_CONTAINER,
    DISCONNECTING_NETWORKS,
    CREATING_CONTAINER,
    CONNECTING_NETWORKS,
    STARTING_CONTAINER,
    MOVING_MONITORS_AND_HISTORY,
    REMOVING_REPLACED_CONTAINER,
    REMOVING_REPLACED_IMAGE,
    ROLLING_BACK
}

interface DockerContainerUpdateEvent {
    jobId: UUID!
    # The container being replaced. Its id stays the same for every event of a job, including
    # the last one, by which point that container is gone
    containerId: String!
    timestamp: Instant!
}

# The update moved on to a step
#
# Steps arrive in the order of the DockerContainerUpdateStep enum and each is reported once, so
# the previous one is done when the next arrives. Steps with nothing to do are skipped, not
# reported as instant: an update with pullImage false never reports PULLING_IMAGE, a container
# that was not running reports neither STOPPING_CONTAINER nor STARTING_CONTAINER, one on no
# network reports no network steps, and REMOVING_REPLACED_IMAGE only arrives when the update
# left the image behind untagged and unused. Do not build the checklist from what arrives, build
# it from the enum and tick items off
type DockerContainerUpdateStepChanged implements DockerContainerUpdateEvent {
    jobId: UUID!
    containerId: String!
    timestamp: Instant!
    step: DockerContainerUpdateStep!
}

# How far the image pull has got, sent whenever a layer changes phase and about once a second
# in between while the step is PULLING_IMAGE
#
# A layer is downloaded and then extracted. The download is always measured in bytes; whether
# the extraction is depends on the image store the daemon uses. The classic overlay2 store
# reports it in bytes, the containerd store reports it as seconds elapsed instead, and the byte
# fields are null there. Counting layers works on both: layersExtracted against layersTotal,
# and the phase of each layer
#
# Best effort throughout. Layers are announced as the registry reaches them, so every total grows
# during the pull and is only the whole image once the last layer has been seen — a percentage
# from any of them climbs and then drops as more layers appear. Layers already present locally
# report no size, so a mostly cached pull completes having counted almost no bytes, and an image
# that is entirely cached reports null for every byte field while the layer counts still add up
type DockerContainerUpdateImagePullProgress implements DockerContainerUpdateEvent {
    jobId: UUID!
    containerId: String!
    timestamp: Instant!
    imageRef: String!
    # Summed over the layers that report a size, null while none of them do. None of them go
    # backwards: a layer keeps its size once known and counts as whole once it leaves the phase
    downloadedBytes: Long
    downloadTotalBytes: Long
    # Null on a daemon whose image store does not measure extraction in bytes
    extractedBytes: Long
    extractTotalBytes: Long
    # Layers seen so far, which is the whole image only once the last one has been announced
    layersTotal: Int!
    layersDownloaded: Int!
    layersExtracted: Int!
    layers: [DockerImagePullLayer!]!
}

enum DockerImagePullLayerPhase {
    WAITING,
    DOWNLOADING,
    DOWNLOADED,
    EXTRACTING,
    COMPLETE,
    # The layer was already on this machine and is neither downloaded nor extracted
    ALREADY_PRESENT
}

type DockerImagePullLayer {
    id: String!
    phase: DockerImagePullLayerPhase!
    # Docker's own wording behind the phase, e.g. Verifying Checksum. Shown as is or not at all,
    # it is not a stable value to branch on
    status: String!
    downloadedBytes: Long
    downloadTotalBytes: Long
    # Null on a daemon whose image store does not measure extraction in bytes
    extractedBytes: Long
    extractTotalBytes: Long
    # What that kind of daemon reports instead: how long this layer has been extracting, and how
    # long it took once the layer is COMPLETE. There is no total to go with it, so it is something
    # to show ticking rather than to fill a bar with, and it is null on a daemon reporting bytes
    extractElapsedSeconds: Long
}

# The container was replaced. Last event of the job
type DockerContainerUpdateSucceeded implements DockerContainerUpdateEvent {
    jobId: UUID!
    containerId: String!
    timestamp: Instant!
    # The container that replaced it. Monitors, history and the image update status have already
    # been moved over to this id, and the old id no longer resolves
    newContainerId: String!
    # Set when the container was started by compose: it now differs from its compose file
    composeProject: String
}

# The update failed. Last event of the job
type DockerContainerUpdateFailed implements DockerContainerUpdateEvent {
    jobId: UUID!
    containerId: String!
    timestamp: Instant!
    # The step that failed
    step: DockerContainerUpdateStep!
    reason: String!
    # Whether the original container was put back the way it was. False means it needs attention:
    # it may be stopped, renamed to <name>-old, or missing networks
    rolledBack: Boolean!
}

enum DockerContainerUpdateJobState {
    # Accepted, waiting for an earlier update to finish first. Updates run one at a time
    QUEUED,
    RUNNING,
    SUCCEEDED,
    FAILED
}

# The state of a job started with updateDockerContainer, for a client that was not there to see
# it start. Returned by containerUpdateJob, which this mirrors the subscription behaviour of:
# the same 30 minute forget window and restart behaviour apply
type DockerContainerUpdateJob {
    jobId: UUID!
    containerId: String!
    state: DockerContainerUpdateJobState!
    startedAt: Instant!
    finishedAt: Instant
    # The last event the dockerContainerUpdate subscription would have delivered. Null only
    # while QUEUED
    lastEvent: DockerContainerUpdateEvent
}

input UpdateDockerContainersInput {
    containerIds: [String!]!
    # Pull the image before recreating each container. Same meaning as on updateDockerContainer,
    # applied to every container in the batch
    pullImage: Boolean! = true
}

# The batch was accepted and is now running
type UpdateDockerContainersOutputStarted {
    # Pass this to the dockerContainerBatchUpdate subscription to follow the batch
    batchJobId: UUID!
    # The order the batch will attempt them in. A container id repeated in the input is only
    # attempted once
    containerIds: [String!]!
}

# The batch was refused before anything happened: the container list was empty
type UpdateDockerContainersOutputFailed {
    reason: String!
}

union UpdateDockerContainersOutput = UpdateDockerContainersOutputStarted | UpdateDockerContainersOutputFailed

input AbortDockerContainerBatchUpdateInput {
    batchJobId: UUID!
}

type AbortDockerContainerBatchUpdateOutputAccepted {
    batchJobId: UUID!
}

# The batch was refused: no such batch, or it had already finished
type AbortDockerContainerBatchUpdateOutputFailed {
    reason: String!
}

union AbortDockerContainerBatchUpdateOutput = AbortDockerContainerBatchUpdateOutputAccepted | AbortDockerContainerBatchUpdateOutputFailed

interface DockerContainerBatchUpdateEvent {
    batchJobId: UUID!
    timestamp: Instant!
}

# First event of the job. Containers are attempted in this order, one at a time
type DockerContainerBatchUpdateStarted implements DockerContainerBatchUpdateEvent {
    batchJobId: UUID!
    timestamp: Instant!
    containerIds: [String!]!
}

# The batch moved on to updating this container
# jobId follows the dockerContainerUpdate subscription for its step-by-step progress
type DockerContainerBatchUpdateContainerStarted implements DockerContainerBatchUpdateEvent {
    batchJobId: UUID!
    timestamp: Instant!
    containerId: String!
    jobId: UUID!
}

# A container's update reached a terminal outcome. The batch moves on to the next container
# regardless of succeeded
type DockerContainerBatchUpdateContainerFinished implements DockerContainerBatchUpdateEvent {
    batchJobId: UUID!
    timestamp: Instant!
    containerId: String!
    # Null when the container's update was refused before a job could be started for it, for
    # example because it was already being updated outside this batch. Otherwise the same jobId
    # carried on this container's DockerContainerBatchUpdateContainerStarted event
    jobId: UUID
    succeeded: Boolean!
    # Set when succeeded is false
    reason: String
}

# The container was never attempted because the batch had already been aborted
type DockerContainerBatchUpdateContainerSkipped implements DockerContainerBatchUpdateEvent {
    batchJobId: UUID!
    timestamp: Instant!
    containerId: String!
}

# Last event of the job
type DockerContainerBatchUpdateFinished implements DockerContainerBatchUpdateEvent {
    batchJobId: UUID!
    timestamp: Instant!
    # True when abortDockerContainerBatchUpdate cut the batch short
    aborted: Boolean!
}

enum DockerContainerBatchUpdateJobState {
    # Accepted, waiting for an earlier batch to finish first. Batches run one at a time
    QUEUED,
    RUNNING,
    FINISHED
}

# The state of a batch started with updateDockerContainers, for a client that was not there to
# see it start. Returned by containerBatchUpdateJob, which mirrors the subscription behaviour of:
# the same 30 minute forget window and restart behaviour apply
type DockerContainerBatchUpdateJob {
    batchJobId: UUID!
    containerIds: [String!]!
    state: DockerContainerBatchUpdateJobState!
    startedAt: Instant!
    finishedAt: Instant
    # The last event the dockerContainerBatchUpdate subscription would have delivered. Null only
    # while QUEUED
    lastEvent: DockerContainerBatchUpdateEvent
}

type ReadLogsForContainerOutputFailed {
    reason: String!
}

type ReadLogsForContainerOutputSucceeded {
    lines: [String!]!
}

union ReadLogsForContainerOutput = ReadLogsForContainerOutputSucceeded | ReadLogsForContainerOutputFailed

union Docker = DockerAvailable | DockerUnavailable

type DockerAvailable {
    container(id: String!): DockerContainer
    containers: [DockerContainer!]!
    runningContainers: [DockerContainer!]!
    containersWithImageUpdates: [DockerContainer!]!
    readLogsForContainer(containerId: String!, from: OffsetDateTime, to: OffsetDateTime): ReadLogsForContainerOutput @deprecated(reason: "Replaced by readLogsForContainerBetweenTimestamps")
    readLogsForContainerBetweenTimestamps(containerId: String!, from: Instant, to: Instant): ReadLogsForContainerOutput
    metricsForContainer(containerId: String!): DockerContainerMetrics
    containerMetricsHistoryBetweenTimestamps(containerId: String!, from: Instant!, to: Instant!): [DockerContainerMetricsHistoryEntry!]!
    openDockerLogMessageConnection(containerId: String! after: String, before: String, first: Int, last: Int, reverse: Boolean): DockerLogMessageConnection!
    # The update currently running or queued, if any, without needing the jobId a mutation
    # returned. Pass jobId to look up a specific job instead, including one that already
    # finished, under the same rules as the dockerContainerUpdate subscription
    containerUpdateJob(jobId: UUID): DockerContainerUpdateJob
    # The batch currently running or queued, if any, without needing the batchJobId a mutation
    # returned. Pass batchJobId to look up a specific batch instead, including one that already
    # finished, under the same rules as the dockerContainerBatchUpdate subscription
    containerBatchUpdateJob(batchJobId: UUID): DockerContainerBatchUpdateJob
}

type DockerUnavailable{
    reason: String!
    isDisabled: Boolean
}

type DockerLogLine {
    line: String!
}

type DockerLogLineEdge {
    node: DockerLogLine!
    cursor: String!
}

type DockerLogLineConnection {
    totalCount: Int!
    edges: [DockerLogLineEdge!]!
    pageInfo: PageInfo!
}

enum DockerContainerState {
    CREATED,
    RESTARTING,
    RUNNING,
    PAUSED,
    EXITED,
    DEAD,
    UNKNOWN
}

type DockerContainer {
    command: String!
    created: Long!
    hostConfig: DockerHostConfig!
    config: DockerConfig!
    id: String!
    image: String!
    imageID: String!
    mounts: [DockerMount!]!
    names: [String!]!
    networkSettings: [DockerNetworkSetting!]!
    ports: [DockerPort!]!
    state: DockerContainerState!
    health: DockerContainerHealth
    status: String!
    imageUpdate: DockerContainerImageUpdate!
    updateEligibility: DockerContainerUpdateEligibility!
}

enum DockerImageUpdateStatus {
    UP_TO_DATE,
    OUTDATED,
    SKIPPED,
    ERROR,
    UNKNOWN
}

type DockerContainerImageUpdate {
    status: DockerImageUpdateStatus!
    imageRef: String!
    remoteDigest: String
    # why the image was skipped or why the check failed
    reason: String
    checkedAt: Instant
}

# Whether updateDockerContainer would be allowed to try, and why not if it would refuse.
# Independent of imageUpdate: a container can be up to date and not updatable, or outdated and
# updatable
type DockerContainerUpdateEligibility {
    updatable: Boolean!
    # Set when updatable is false
    reason: String
}

type DockerContainerMetrics{
    cpuUsage: DockerContainerCpuUsage!
    memoryUsage: DockerContainerMemoryUsage!
    currentPid: Long!
    networkUsage: DockerContainerNetworkUsage!
    blockIOUsage: DockerContainerBlockIOUsage!
}

type DockerContainerMetricsHistoryEntry {
    timestamp: Instant!
    metrics: DockerContainerMetrics!
}

type DockerContainerCpuUsage{
    usagePercentPerCore: Float!
    usagePercentTotal: Float!
    throttlingData: DockerContainerThrottlingData!
}

type DockerContainerThrottlingData{
    periods: Long!
    throttledPeriods: Long!
    throttledTime: Long!
}

type DockerContainerNetworkUsage{
    bytesReceived: Long!
    bytesTransferred: Long!
}

type DockerContainerBlockIOUsage{
    bytesWritten: Long!
    bytesRead: Long!
}

type DockerContainerMemoryUsage{
    usageBytes: Long!
    usagePercent: Float!
    limitBytes: Long!
}

type DockerContainerHealth{
    status: String
    failingStreak: Int,
    logEntries: [DockerHealthLogEntry!]!
}

type DockerHealthLogEntry{
    start: String!
    end: String!
    output: String!
    exitCode: Long!
}

type DockerConfig{
    env: [String!]!
    volumeBindings: [DockerVolumeBinding!]!
    cmd: [String!]!
    exposedPorts: [DockerPortConfig!]!
}

type DockerPortConfig{
    port: Int!
    portProtocol: DockerPortProtocol!
}

type DockerVolumeBinding{
    hostPath: String!
    containerPath: String!
}

enum DockerPortProtocol {
    UDP,
    TCP,
    SCTP
}

type DockerNetworkSetting {
    name: String!
    network: DockerNetwork!
}

type DockerPort {
    ip: String!
    privatePort: Int!
    publicPort: Int!
    type: String!
}

type DockerNetwork {
    aliases: [String!]!
    endpointID: String!
    gateway: String!
    globalIPv6Address: String!
    globalIPv6PrefixLen: Int!
    iPAMConfig: DockerIpam!
    iPAddress: String!
    iPPrefixLen: Int!
    iPv6Gateway: String!
    links: [DockerLink!]!
    macAddress: String!
    networkID: String!
}

type DockerLink {
    name: String!,
    alias: String!
}

type DockerIpam {
    ipv4Address: String
    ipv6Address: String
}

type DockerMount {
    destination: String!,
    driver: String!,
    mode: String!,
    name: String!,
    propagation: String!,
    rw: Boolean!,
    source: String!
}

type DockerHostConfig {
    networkMode: String!
}

enum ContainerCommand {
    START,
    STOP,
    RESTART,
    PAUSE,
    UNPAUSE,
}

type DockerLogMessage {
    timestamp: Instant!
    level: DockerLogMessageLevel!
    message: String!
}

type DockerLogMessageEdge {
    cursor: String!
    node: DockerLogMessage!
}

type DockerLogMessageConnection {
    edges: [DockerLogMessageEdge!]!
    pageInfo: PageInfo!
}

enum DockerLogMessageLevel {
    TRACE, DEBUG, INFO, WARN, ERROR, FATAL, UNKNOWN
}