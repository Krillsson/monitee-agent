extend type Query {
    proxmox: ProxmoxInfo!
}

extend type Subscription {
    # Live metrics for one guest, emitted every proxmox.pollIntervalSeconds while subscribed
    proxmoxGuestMetricsById(id: String!): ProxmoxGuestMetrics

    # Follow a command started with performProxmoxGuestCommand
    #
    # Everything the job has emitted so far is replayed on subscribe, so subscribing after the
    # mutation returned misses nothing. The stream completes after ProxmoxGuestCommandSucceeded or
    # ProxmoxGuestCommandFailed. Finished jobs are forgotten after 30 minutes and do not survive a
    # restart of the agent
    proxmoxGuestCommand(jobId: UUID!): ProxmoxGuestCommandEvent!
}

extend type Mutation {
    # Starts a power action on a guest and returns as soon as Proxmox has accepted it. Proxmox
    # runs the action as a task, follow it with the proxmoxGuestCommand subscription. Needs
    # VM.PowerMgmt for the API token, see docs/proxmox.md
    performProxmoxGuestCommand(input: PerformProxmoxGuestCommandInput!): PerformProxmoxGuestCommandOutput!
}

union ProxmoxInfo = ProxmoxInfoAvailable | ProxmoxInfoUnavailable

type ProxmoxInfoUnavailable {
    reason: String!
    isDisabled: Boolean
}

type ProxmoxInfoAvailable {
    cluster: ProxmoxCluster!
    nodes: [ProxmoxNode!]!
    nodeByName(name: String!): ProxmoxNode
    # Templates are left out unless proxmox.includeTemplates is set
    guests: [ProxmoxGuest!]!
    runningGuests: [ProxmoxGuest!]!
    # id is the vmid as a string, e.g. "100"
    guest(id: String!): ProxmoxGuest
    storages: [ProxmoxStorage!]!
    # Reads the configured API token is not allowed to make, one line each. Empty when the token
    # has PVEAuditor on /
    warnings: [String!]!
    # Everything here is from this poll. Proxmox is reported unavailable after three failed polls
    # in a row, until then the last answer is kept
    lastSuccessfulPoll: Instant!
    pveVersion: String!
    # The most recently started command that is still running, if any. Pass jobId to look up a
    # specific job instead, including one that finished in the last 30 minutes. Null when no job
    # has that id, or it has been forgotten
    guestCommandJob(jobId: UUID): ProxmoxGuestCommandJob
}

type ProxmoxCluster {
    # Null on a standalone node, or when the API token may not read the cluster status
    name: String
    quorate: Boolean!
    nodeCount: Int!
}

enum ProxmoxNodeStatus {
    ONLINE
    OFFLINE
    UNKNOWN
}

type ProxmoxNode {
    name: String!
    status: ProxmoxNodeStatus!
    # True for the node the agent is talking to
    local: Boolean!
    ip: String
    uptimeSeconds: Long
    cpuUsagePercent: Float
    cpuCount: Int
    cpuModel: String
    memoryUsedBytes: Long
    memoryTotalBytes: Long
    # Memory merged by kernel same-page merging. Null when Proxmox does not report it
    ksmSharedBytes: Long
    loadAverages: [Float!]
    rootFsUsedBytes: Long
    rootFsTotalBytes: Long
    # e.g. pve-manager/9.0.3/...
    pveVersion: String
    kernelRelease: String
    # Set when the node is listed but its own status could not be read, e.g. when the node the
    # agent talks to cannot reach it
    detailUnavailableReason: String
    guests: [ProxmoxGuest!]!
    storages: [ProxmoxStorage!]!
}

enum ProxmoxGuestKind {
    # A virtual machine
    QEMU
    # A container
    LXC
}

enum ProxmoxGuestStatus {
    RUNNING
    STOPPED
    # What Proxmox reports once the guest's node has been offline for a few minutes. The guest is
    # still listed
    UNKNOWN
}

type ProxmoxGuest {
    # The vmid as a string. Stable across migrations and restarts
    id: String!
    vmid: Int!
    kind: ProxmoxGuestKind!
    name: String!
    node: String!
    status: ProxmoxGuestStatus!
    template: Boolean!
    tags: [String!]!
    # Null unless the guest is HA managed. Proxmox's own state names: started, stopped,
    # request_stop, stopping, starting, fence, recovery, freeze, ignored, migrate, error,
    # queued, disabled
    haState: String
    # The config lock Proxmox holds on the guest (backup, migrate, snapshot, ...), null when free
    lock: String
    uptimeSeconds: Long!
    cpuCount: Int!
    memoryTotalBytes: Long!
    # Null unless the guest is running
    metrics: ProxmoxGuestMetrics
    # The latest command started on this guest from the agent, running or finished in the last
    # 30 minutes
    commandJob: ProxmoxGuestCommandJob

    # The fields below are read from the guest's own status and config, one request per guest,
    # so ask for them on a detail screen rather than in a list

    # The commands this guest accepts right now. Empty for templates, locked guests, guests in a
    # failed HA state and while the cluster has no quorum. A suspended VM only accepts RESUME and
    # FORCE_STOP
    supportedCommands: [ProxmoxGuestCommand!]!
    # QEMU only: the QMP run state (running, paused, prelaunch, suspended, ...), or "stopped".
    # Null for LXC
    qmpStatus: String
    # QEMU only: whether the guest agent is enabled in the config, not whether it answers
    agentEnabled: Boolean
    # QEMU: the ostype from the config (l26, win11, ...). LXC: the distribution (debian, alpine, ...)
    osType: String
    # LXC only. Null for QEMU
    unprivileged: Boolean
    # LXC only. Null for QEMU
    swapUsedBytes: Long
    # LXC only. Null for QEMU
    swapTotalBytes: Long
    # From the guest agent for QEMU, from the container itself for LXC. Null when neither is
    # available, networkUnavailableReason says why
    network: ProxmoxGuestNetwork
    networkUnavailableReason: String
}

type ProxmoxGuestNetwork {
    hostname: String
    interfaces: [ProxmoxGuestNetworkInterface!]!
}

type ProxmoxGuestNetworkInterface {
    name: String!
    macAddress: String
    ipv4: [String!]!
    ipv6: [String!]!
}

# Field names follow DockerContainerMetrics where the meaning is the same
type ProxmoxGuestMetrics {
    id: String!
    cpuUsage: ProxmoxGuestCpuUsage!
    memoryUsage: ProxmoxGuestMemoryUsage!
    networkUsage: ProxmoxGuestNetworkUsage!
    blockIOUsage: ProxmoxGuestBlockIOUsage!
    # LXC only: rootfs usage. Null for QEMU, for which Proxmox reports no disk usage
    diskUsage: ProxmoxGuestDiskUsage
}

type ProxmoxGuestCpuUsage {
    # Percent of the guest's own cpuCount, 0-100
    usagePercentTotal: Float!
}

type ProxmoxGuestMemoryUsage {
    # QEMU: what the guest reports through the balloon driver when it does, otherwise the host's
    # view. LXC: the container's cgroup
    usageBytes: Long!
    usagePercent: Float!
    limitBytes: Long!
    # QEMU on Proxmox VE 9 only: the host's view of the same guest. Null elsewhere
    hostUsageBytes: Long
}

# Counters since the guest started, in bytes
type ProxmoxGuestNetworkUsage {
    bytesReceived: Long!
    bytesTransferred: Long!
}

# Counters since the guest started, in bytes. Not available for every storage type
type ProxmoxGuestBlockIOUsage {
    bytesRead: Long!
    bytesWritten: Long!
}

type ProxmoxGuestDiskUsage {
    usageBytes: Long!
    limitBytes: Long!
}

enum ProxmoxStorageStatus {
    AVAILABLE
    UNKNOWN
}

type ProxmoxStorage {
    # "<node>/<storage>". A shared storage is listed once per node, use shared to collapse them
    id: String!
    storage: String!
    node: String!
    # dir, lvmthin, zfspool, nfs, pbs, ... Null when Proxmox does not report it
    type: String
    status: ProxmoxStorageStatus!
    # False when Proxmox does not report it
    shared: Boolean!
    # What the storage holds: images, rootdir, backup, iso, vztmpl, snippets, import
    content: [String!]!
    usedBytes: Long
    totalBytes: Long
}

enum ProxmoxGuestCommand {
    START
    # The ACPI power button, or the guest agent when it answers. Waits proxmox.shutdownTimeoutSeconds
    # and fails if the guest is still up, nothing is killed. Follow up with FORCE_STOP
    SHUTDOWN
    # Pulls the plug
    FORCE_STOP
    # A shutdown followed by a start, with the same timeout as SHUTDOWN. A VM that does not shut
    # down in time fails the reboot, a container is killed
    REBOOT
    # VMs only, pauses the guest in memory
    SUSPEND
    # VMs only
    RESUME
}

input PerformProxmoxGuestCommandInput {
    guestId: String!
    command: ProxmoxGuestCommand!
}

type PerformProxmoxGuestCommandOutputStarted {
    # Pass this to the proxmoxGuestCommand subscription to follow the command
    jobId: UUID!
    guestId: String!
    # The id of the Proxmox task running the command
    upid: String!
}

# The command was refused before it ran: Proxmox is unavailable, there is no such guest, the
# guest does not accept it right now (see supportedCommands), a command for it is already
# running, or Proxmox refused it, e.g. because the API token lacks VM.PowerMgmt
type PerformProxmoxGuestCommandOutputFailed {
    reason: String!
}

union PerformProxmoxGuestCommandOutput = PerformProxmoxGuestCommandOutputStarted | PerformProxmoxGuestCommandOutputFailed

interface ProxmoxGuestCommandEvent {
    jobId: UUID!
    guestId: String!
    timestamp: Instant!
}

# Proxmox accepted the command and is running its task. Sent once, first
type ProxmoxGuestCommandRunning implements ProxmoxGuestCommandEvent {
    jobId: UUID!
    guestId: String!
    timestamp: Instant!
    upid: String!
}

type ProxmoxGuestCommandSucceeded implements ProxmoxGuestCommandEvent {
    jobId: UUID!
    guestId: String!
    timestamp: Instant!
    upid: String!
    # OK, or WARNINGS: n
    exitStatus: String!
}

type ProxmoxGuestCommandFailed implements ProxmoxGuestCommandEvent {
    jobId: UUID!
    guestId: String!
    timestamp: Instant!
    upid: String!
    # Proxmox's error, e.g. "VM quit/powerdown failed - got timeout", or why the agent stopped
    # following the task
    reason: String!
    # The last lines of the task's log. Empty when the agent stopped following the task
    log: [String!]!
    # True when a SHUTDOWN or REBOOT timed out and FORCE_STOP would stop the guest
    canForceStop: Boolean!
}

enum ProxmoxGuestCommandJobState {
    RUNNING
    SUCCEEDED
    FAILED
}

type ProxmoxGuestCommandJob {
    jobId: UUID!
    guestId: String!
    command: ProxmoxGuestCommand!
    upid: String!
    state: ProxmoxGuestCommandJobState!
    startedAt: Instant!
    finishedAt: Instant
    # The last event the proxmoxGuestCommand subscription delivered
    lastEvent: ProxmoxGuestCommandEvent!
}
