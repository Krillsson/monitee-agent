extend type Query {
    notificationServices: NotificationServicesInfo!
}

extend type Mutation {
    "Suppresses every outgoing notification until `until`, or until resumeNotifications when omitted"
    snoozeNotifications(input: SnoozeNotificationsInput!): SnoozeNotificationsInfo!
    "Ends an active snooze immediately. A no-op when nothing is snoozed"
    resumeNotifications: SnoozeNotificationsInfo!
    "Changes the quiet hours, cooldown and recovery settings. Omitted fields keep their current value"
    updateNotificationPolicy(input: NotificationPolicyInput!): NotificationPolicy!
}

type NotificationServicesInfo{
    serverId: String,
    ntfy: NtfyInfo!
    "Webhooks configured under notifications.webhooks in configuration.yml"
    webhooks: [WebhookInfo!]!
    "The MQTT broker the agent publishes metrics and events to, configured under mqtt in configuration.yml"
    mqtt: MqttInfo!
    "Notification suppression state. Never null - check `snoozed`"
    snooze: SnoozeNotificationsInfo!
    "Which notifications the agent sends. Applies to ntfy, webhooks and MQTT alike"
    policy: NotificationPolicy!
}

input SnoozeNotificationsInput {
    "When the snooze lifts by itself. Omit for an open-ended snooze"
    until: Instant
    "Optional free text shown by clients, e.g. 'Upgrading unRAID'"
    reason: String
}

type SnoozeNotificationsInfo {
    "True while outgoing notifications are being dropped"
    snoozed: Boolean!
    "When the current snooze began. Null when not snoozed"
    snoozedAt: Instant
    "When the current snooze lifts. Null when not snoozed, or when it is open-ended"
    snoozedUntil: Instant
    "Reason supplied by whoever snoozed"
    reason: String
    "Notifications dropped since this snooze began. Resets when the agent restarts"
    suppressedNotificationCount: Int!
}

type NotificationPolicy {
    quietHours: QuietHours!
    "After a notification for a new event on a monitor, further events on that monitor send nothing for this many minutes. 0 turns it off"
    cooldownMinutes: Int!
    "When false, nothing is sent when an event resolves"
    notifyOnRecovery: Boolean!
    "Dropped since start, by reason"
    suppressed: SuppressedNotificationCounts!
}

type QuietHours {
    enabled: Boolean!
    "Local time the window opens, as HH:mm"
    start: String!
    "Local time the window closes, as HH:mm. Earlier than start for a window that crosses midnight"
    end: String!
    "Days the window opens on. A window crossing midnight belongs to the day it opens"
    days: [DayOfWeek!]!
    "IANA time zone start and end are read in. Defaults to the agent's system zone"
    timeZone: String!
    "When true, a CRITICAL event is sent even inside the window"
    allowCritical: Boolean!
    "True right now, so clients can mirror the agent's decision"
    active: Boolean!
}

type SuppressedNotificationCounts {
    "Further notifications for an acknowledged event"
    acknowledged: Int!
    "Events on a monitor inside its cooldown, and their recoveries"
    cooldown: Int!
    "Notifications inside quiet hours"
    quietHours: Int!
    "Recoveries dropped because notifyOnRecovery is false"
    recovery: Int!
}

enum DayOfWeek {
    MONDAY
    TUESDAY
    WEDNESDAY
    THURSDAY
    FRIDAY
    SATURDAY
    SUNDAY
}

input NotificationPolicyInput {
    quietHours: QuietHoursInput
    "0 turns the cooldown off"
    cooldownMinutes: Int
    notifyOnRecovery: Boolean
}

input QuietHoursInput {
    enabled: Boolean
    "HH:mm"
    start: String
    "HH:mm, must differ from start"
    end: String
    "At least one day"
    days: [DayOfWeek!]
    "An IANA time zone such as Europe/Stockholm"
    timeZone: String
    allowCritical: Boolean
}

type NtfyInfo{
    enabled: Boolean
    ntfyAppTopicDeeplink: String
    topic: String,
}

type WebhookInfo{
    "The configured name, or the host of the webhook url when it has none"
    name: String!
    enabled: Boolean!
}

type MqttInfo{
    "True when a broker url is configured and publishing is turned on"
    enabled: Boolean!
    "Whether the agent currently holds a connection to the broker"
    connected: Boolean!
    "The broker url the agent connects to"
    url: String!
    "Retained topic carrying every metric as one JSON object"
    stateTopic: String!
    "Topic every notification is published to as it happens"
    eventTopic: String!
}