extend type Query {
    checks: [Check!]!
    checkById(id: UUID!): Check
    # Whether a ping check can run on this agent, which is worth asking before offering the
    # PING type. Answered the first time it is asked by pinging the loopback address
    pingAvailability: PingAvailability!
}

extend type Mutation {
    createHttpCheck(input: CreateHttpCheckInput!): CreateCheckOutput!
    updateHttpCheck(input: UpdateHttpCheckInput!): UpdateCheckOutput!
    createTcpCheck(input: CreateTcpCheckInput!): CreateCheckOutput!
    updateTcpCheck(input: UpdateTcpCheckInput!): UpdateCheckOutput!
    createPingCheck(input: CreatePingCheckInput!): CreateCheckOutput!
    updatePingCheck(input: UpdatePingCheckInput!): UpdateCheckOutput!
    createDnsCheck(input: CreateDnsCheckInput!): CreateCheckOutput!
    updateDnsCheck(input: UpdateDnsCheckInput!): UpdateCheckOutput!
    deleteCheck(input: DeleteCheckInput!): DeleteCheckOutput!
    setCheckEnabled(input: SetCheckEnabledInput!): UpdateCheckOutput!
    # Runs a stored check right away and persists the result, regardless of when it was last due
    runCheckNow(input: RunCheckNowInput!): RunCheckNowOutput!
    # Probes without storing anything, for trying a check out before saving it
    runOneOffHttpCheck(input: OneOffHttpCheckInput!): CheckResult!
    runOneOffTcpCheck(input: OneOffTcpCheckInput!): CheckResult!
    runOneOffPingCheck(input: OneOffPingCheckInput!): CheckResult!
    runOneOffDnsCheck(input: OneOffDnsCheckInput!): CheckResult!
}

enum CheckType {
    HTTP
    TCP
    PING
    DNS
}

interface Check {
    id: UUID!
    # Falls back to the address being checked when the user has not named it
    name: String!
    type: CheckType!
    enabled: Boolean!
    intervalSeconds: Int!
    timeoutSeconds: Int!
    # The most recent result, null until the check has run once
    status: CheckResult
    uptimeMetrics(from: Instant, to: Instant): CheckUptime!
    history(from: Instant!, to: Instant!, resolution: CheckResolution): CheckHistory!
    # Individual probe results with their messages and error bodies. Only kept for the raw
    # retention window, which defaults to 48 hours
    results(from: Instant!, to: Instant!, limit: Int): [CheckResult!]!
}

type HttpCheck implements Check {
    id: UUID!
    name: String!
    type: CheckType!
    enabled: Boolean!
    intervalSeconds: Int!
    timeoutSeconds: Int!
    status: CheckResult
    uptimeMetrics(from: Instant, to: Instant): CheckUptime!
    history(from: Instant!, to: Instant!, resolution: CheckResolution): CheckHistory!
    results(from: Instant!, to: Instant!, limit: Int): [CheckResult!]!
    url: String!
    method: HttpMethod!
    # Status codes counted as up, as a comma separated list of codes and ranges: "200-299,301"
    expectedStatusCodes: String!
    # When set, the response body must contain this text for the check to pass
    keyword: String
    # Inverts the keyword assertion, so the check passes when the body does not contain it
    keywordInverted: Boolean!
    # Accepts self signed and otherwise untrusted certificates for this check only
    ignoreCertificateErrors: Boolean!
    followRedirects: Boolean!
    headers: [HttpHeader!]!
}

type TcpCheck implements Check {
    id: UUID!
    name: String!
    type: CheckType!
    enabled: Boolean!
    intervalSeconds: Int!
    timeoutSeconds: Int!
    status: CheckResult
    uptimeMetrics(from: Instant, to: Instant): CheckUptime!
    history(from: Instant!, to: Instant!, resolution: CheckResolution): CheckHistory!
    results(from: Instant!, to: Instant!, limit: Int): [CheckResult!]!
    # Host name or address to open a connection to. The check passes when the connection is
    # accepted, and the latency is how long that took
    host: String!
    port: Int!
}

type PingCheck implements Check {
    id: UUID!
    name: String!
    type: CheckType!
    enabled: Boolean!
    intervalSeconds: Int!
    timeoutSeconds: Int!
    status: CheckResult
    uptimeMetrics(from: Instant, to: Instant): CheckUptime!
    history(from: Instant!, to: Instant!, resolution: CheckResolution): CheckHistory!
    results(from: Instant!, to: Instant!, limit: Int): [CheckResult!]!
    host: String!
    # False when this agent has no working ping command: it is not installed, the platform
    # is not one this agent knows how to run ping on, or the process may not send ICMP echo
    # requests, which needs either root, CAP_NET_RAW or a permissive net.ipv4.ping_group_range.
    # Creating or updating a ping check is refused while this is false, and an existing one
    # reports every probe as down. Use a TCP check instead
    pingAvailable: Boolean!
}

type PingAvailability {
    available: Boolean!
    # Why ping checks cannot run here, null when they can: ping is not installed, the platform
    # is not one this agent knows how to run ping on, or the process may not send ICMP echo
    # requests, which needs either root, CAP_NET_RAW or a permissive net.ipv4.ping_group_range
    unavailableReason: String
}

type DnsCheck implements Check {
    id: UUID!
    name: String!
    type: CheckType!
    enabled: Boolean!
    intervalSeconds: Int!
    timeoutSeconds: Int!
    status: CheckResult
    uptimeMetrics(from: Instant, to: Instant): CheckUptime!
    history(from: Instant!, to: Instant!, resolution: CheckResolution): CheckHistory!
    results(from: Instant!, to: Instant!, limit: Int): [CheckResult!]!
    # The name being looked up
    hostname: String!
    # The server to ask, as an address with an optional port such as "192.168.1.2" or
    # "192.168.1.2:5335". Null asks the resolver this machine uses
    resolver: String
    recordType: DnsRecordType!
    # The check only passes when every one of these turns up in the answer, compared against
    # the record data as dig prints it and without a trailing dot. Empty asserts nothing beyond
    # the name resolving at all
    expectedValues: [String!]!
}

enum DnsRecordType {
    A
    AAAA
    CNAME
    MX
    TXT
    NS
}

enum HttpMethod {
    GET
    HEAD
    POST
}

type HttpHeader {
    name: String!
    value: String!
}

type CheckResult {
    # Null for one-off probes, which are not stored
    checkId: UUID
    checkType: CheckType!
    timestamp: Instant!
    successful: Boolean!
    latencyMs: Long!
    message: String!
    # HTTP only. -1 when no response was received at all
    responseCode: Int
    # HTTP only. The first 512 characters of the response body
    errorBody: String
    # DNS only. The records the lookup answered with
    resolvedValues: [String!]
}

enum CheckResolution {
    # Picks a resolution from the requested range: raw for the last few hours,
    # hourly up to a month, daily beyond that
    AUTO
    RAW
    HOURLY
    DAILY
}

type CheckHistory {
    # The resolution actually served, which may be coarser than the one asked for
    resolution: CheckResolution!
    from: Instant!
    to: Instant!
    points: [CheckHistoryPoint!]!
}

type CheckHistoryPoint {
    # Start of the bucket, or the probe timestamp at RAW resolution
    timestamp: Instant!
    samples: Int!
    successful: Int!
    failed: Int!
    uptimePercent: Float!
    downtimeSeconds: Long!
    minLatencyMs: Long!
    avgLatencyMs: Long!
    maxLatencyMs: Long!
    # Computed while the raw results still exist. At DAILY resolution it is the highest
    # of the day's hourly p95 values, since a percentile cannot be re-derived from buckets
    p95LatencyMs: Long!
}

type CheckUptime {
    from: Instant!
    to: Instant!
    samples: Int!
    successful: Int!
    failed: Int!
    uptimePercent: Float!
    downtimeSeconds: Long!
    totalSeconds: Long!
}

input CreateHttpCheckInput {
    name: String
    enabled: Boolean
    intervalSeconds: Int
    timeoutSeconds: Int
    url: String!
    method: HttpMethod
    expectedStatusCodes: String
    keyword: String
    keywordInverted: Boolean
    ignoreCertificateErrors: Boolean
    followRedirects: Boolean
    headers: [HttpHeaderInput!]
}

input UpdateHttpCheckInput {
    id: UUID!
    name: String
    enabled: Boolean
    intervalSeconds: Int
    timeoutSeconds: Int
    url: String!
    method: HttpMethod
    expectedStatusCodes: String
    keyword: String
    keywordInverted: Boolean
    ignoreCertificateErrors: Boolean
    followRedirects: Boolean
    headers: [HttpHeaderInput!]
}

input OneOffHttpCheckInput {
    url: String!
    method: HttpMethod
    expectedStatusCodes: String
    keyword: String
    keywordInverted: Boolean
    ignoreCertificateErrors: Boolean
    followRedirects: Boolean
    timeoutSeconds: Int
    headers: [HttpHeaderInput!]
}

input CreateTcpCheckInput {
    name: String
    enabled: Boolean
    intervalSeconds: Int
    timeoutSeconds: Int
    host: String!
    port: Int!
}

input UpdateTcpCheckInput {
    id: UUID!
    name: String
    enabled: Boolean
    intervalSeconds: Int
    timeoutSeconds: Int
    host: String!
    port: Int!
}

input OneOffTcpCheckInput {
    host: String!
    port: Int!
    timeoutSeconds: Int
}

input CreatePingCheckInput {
    name: String
    enabled: Boolean
    intervalSeconds: Int
    timeoutSeconds: Int
    host: String!
}

input UpdatePingCheckInput {
    id: UUID!
    name: String
    enabled: Boolean
    intervalSeconds: Int
    timeoutSeconds: Int
    host: String!
}

input OneOffPingCheckInput {
    host: String!
    timeoutSeconds: Int
}

input CreateDnsCheckInput {
    name: String
    enabled: Boolean
    intervalSeconds: Int
    timeoutSeconds: Int
    hostname: String!
    resolver: String
    recordType: DnsRecordType
    expectedValues: [String!]
}

input UpdateDnsCheckInput {
    id: UUID!
    name: String
    enabled: Boolean
    intervalSeconds: Int
    timeoutSeconds: Int
    hostname: String!
    resolver: String
    recordType: DnsRecordType
    expectedValues: [String!]
}

input OneOffDnsCheckInput {
    hostname: String!
    resolver: String
    recordType: DnsRecordType
    expectedValues: [String!]
    timeoutSeconds: Int
}

input HttpHeaderInput {
    name: String!
    value: String!
}

input DeleteCheckInput {
    id: UUID!
}

input SetCheckEnabledInput {
    id: UUID!
    enabled: Boolean!
}

input RunCheckNowInput {
    id: UUID!
}

union CreateCheckOutput = CreateCheckSuccess | CreateCheckFailed

type CreateCheckSuccess {
    id: UUID!
}

type CreateCheckFailed {
    reason: String!
}

union UpdateCheckOutput = UpdateCheckSuccess | UpdateCheckFailed

type UpdateCheckSuccess {
    id: UUID!
}

type UpdateCheckFailed {
    reason: String!
}

type DeleteCheckOutput {
    removed: Boolean!
}

union RunCheckNowOutput = RunCheckNowSuccess | RunCheckNowFailed

type RunCheckNowSuccess {
    result: CheckResult!
}

type RunCheckNowFailed {
    reason: String!
}
